{
  "engine_decoy_root": "/engine/decoy/",
  "min_risk_score": 0.7,
  "cooldown_seconds": 300,
  "dry_run": false,
  "redirect_tools": ["read", "read_document", "list_directory", "search_files"],
  "target_param": "file_path",
  "mappings": [
    {
      "asset_type": "personal_information",
      "min_sensitivity": "HIGH",
      "template": "personal/{filename}"
    },
    {
      "asset_type": "credential",
      "min_sensitivity": "CRITICAL",
      "template": "credential/{filename}"
    }
  ]
}
